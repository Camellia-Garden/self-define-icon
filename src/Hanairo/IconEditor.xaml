<Window x:Class="Hanairo.IconEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑图标图片" Icon="/Assets/Hanairo.ico"
        Width="790" Height="626" MinWidth="610" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Foreground="{StaticResource Ink}" Background="#F9F4FB">
    <Window.Resources>
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                      Viewbox="0,0,16,16" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFCFF" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#EDE3F3" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>
    <Grid Margin="20,17,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,2,14">
            <Image DockPanel.Dock="Right" Source="/Assets/star.png" Width="48" Height="48" Margin="12,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="编辑图标图片" Style="{StaticResource Title}"/>
                <TextBlock x:Name="ImageFileName" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,11">
                            <TextBlock DockPanel.Dock="Right" Text="1:1 方形" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="裁剪画布" FontWeight="DemiBold" FontSize="16"/>
                        </DockPanel>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <Border BorderBrush="#CDAFDC" BorderThickness="1">
                                <Canvas x:Name="Viewport" Width="342" Height="342" ClipToBounds="True"
                                        UseLayoutRounding="False" Background="{StaticResource Checkerboard}"
                                        Cursor="SizeAll" Focusable="True" KeyboardNavigation.TabIndex="0"
                                        AutomationProperties.Name="方形裁剪画布"
                                        AutomationProperties.HelpText="方向键移动图片。滚轮缩放。"
                                        MouseLeftButtonDown="BeginPan" MouseLeftButtonUp="EndPan" MouseMove="Pan"
                                        LostMouseCapture="LostPan" MouseWheel="ZoomAtPointer" KeyDown="Viewport_KeyDown">
                                    <Image x:Name="SourceImage" IsHitTestVisible="False" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Path IsHitTestVisible="False" Stroke="#B7FFFFFF" StrokeThickness="1"
                                          Data="M114,0 V342 M228,0 V342 M0,114 H342 M0,228 H342"/>
                                    <Path IsHitTestVisible="False" Stroke="#A273A4" StrokeThickness="2"
                                          Data="M2,17 V2 H17 M325,2 H340 V17 M340,325 V340 H325 M17,340 H2 V325"/>
                                </Canvas>
                            </Border>
                        </Viewbox>
                        <TextBlock Text="拖动改变取景，滚轮缩放。方框内即图标成品。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="成品预览" FontWeight="DemiBold" FontSize="16" Margin="0,0,0,11"/>
                            <Border CornerRadius="11" Background="{StaticResource Checkerboard}" Height="110">
                                <Image x:Name="LargePreview" Width="96" Height="96" AutomationProperties.Name="96 像素图标预览"/>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,7,0,0">
                                <StackPanel>
                                    <Border Height="49" Background="#FAF3FC" CornerRadius="8" Margin="0,0,4,0">
                                        <Image x:Name="Preview16" Width="16" Height="16" AutomationProperties.Name="16 像素图标预览"/>
                                    </Border>
                                    <TextBlock Text="16 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <Border Height="49" Background="#F1E8F7" CornerRadius="8" Margin="0,0,4,0">
                                        <Image x:Name="Preview32" Width="32" Height="32" AutomationProperties.Name="32 像素图标预览"/>
                                    </Border>
                                    <TextBlock Text="32 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <Border Height="49" Background="#E8DBF2" CornerRadius="8">
                                        <Image x:Name="Preview48" Width="48" Height="48" AutomationProperties.Name="48 像素图标预览"/>
                                    </Border>
                                    <TextBlock Text="48 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,7">
                                <TextBlock x:Name="ZoomValue" DockPanel.Dock="Right" Foreground="{StaticResource Plum}"
                                           FontWeight="DemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="缩放" FontWeight="DemiBold" FontSize="16"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,9">
                                <Button DockPanel.Dock="Left" Content="−" Click="ZoomOut_Click" AutomationProperties.Name="缩小"
                                        Width="34" Padding="0" Margin="0,0,8,0"/>
                                <Button DockPanel.Dock="Right" Content="+" Click="ZoomIn_Click" AutomationProperties.Name="放大"
                                        Width="34" Padding="0" Margin="8,0,0,0"/>
                                <Slider x:Name="ZoomSlider" Minimum="-2" Maximum="3" VerticalAlignment="Center"
                                        SmallChange="0.125" LargeChange="0.5" IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="图标缩放" ValueChanged="ZoomSlider_Changed"/>
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <Button Content="适应画布" Click="Fit_Click" Margin="0,0,4,0" Padding="5,5"
                                        ToolTip="显示完整图片，空白处透明"/>
                                <Button Content="填满裁剪" Click="Fill_Click" Margin="4,0,0,0" Padding="5,5"
                                        ToolTip="按比例铺满，裁掉方框之外的部分"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,13,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" IsCancel="True" Margin="0,0,8,0" Padding="16,7"/>
                <Button Content="使用此图标" IsDefault="True" Click="UseIcon_Click"
                        Style="{StaticResource Primary}" Padding="17,7"/>
            </StackPanel>
            <TextBlock Text="原图会保留" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
